# Demo runs without keys. Change to openai, gemini or ollama for real AI.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://localhost:11434
# sqlite provides a persistent zero-setup demo. Production stack uses mongodb.
DB_BACKEND=sqlite
SQLITE_PATH=data/meetmind.sqlite3
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=meetmind
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional. Create a Google Web OAuth client and use the same ID in the dashboard.
GOOGLE_CLIENT_ID=
# Optional. Required for server transcription; install requirements-speech.txt.
STT_PROVIDER=disabled
WHISPER_MODEL=base
# When true, uses a private generated JWT key under data/ if JWT_SECRET is absent.
ENVIRONMENT=development
